# Plantilla de configuración de dIAra.
# Copie este archivo como ".env" (en esta misma carpeta, diara/) y complete solo lo que vaya a usar.
# backend/config.py lo lee al arrancar; una variable definida en la consola tiene prioridad sobre este archivo.
# El archivo .env contiene claves: NO lo comparta, no lo envíe por correo ni lo suba a un repositorio.
# Después de cambiarlo, reinicie uvicorn (con --reload no basta: el .env solo se lee al arrancar el proceso).

# ---------- Clima ----------
# Open-Meteo funciona sin clave (uso no comercial). 1 = activo, 0 = apagado.
OPEN_METEO_ACTIVO=1
# Google Weather (Google Cloud: Weather API habilitada, con facturación). Ver README, sección "Clima".
GOOGLE_MAPS_API_KEY=
# Meteoblue Free Weather API (registro gratuito, uso no comercial).
METEOBLUE_API_KEY=
# Meteosource, plan gratuito (400 llamadas/día).
METEOSOURCE_API_KEY=

# ---------- Seguridad ----------
# Clave para firmar las sesiones. Si queda vacía, las sesiones se cierran cada vez que se reinicia el servidor.
# Generar una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---------- Correo (reportes automáticos) ----------
# Sin SMTP_HOST los reportes se generan en modo simulado (no se envían).
# Ejemplos:
#   Microsoft 365 / Outlook institucional: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SEGURIDAD=starttls
#     (el buzón debe tener habilitado "SMTP autenticado"; SMTP_FROM = la misma cuenta de SMTP_USER)
#   Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SEGURIDAD=starttls
#     (SMTP_PASS = contraseña de aplicación de 16 caracteres; requiere verificación en dos pasos)
# Verificar con: python backend/enviar_reportes.py --prueba su_correo@dominio
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SEGURIDAD=starttls
# Programador interno: 1 = el servidor envía solo los reportes a la hora configurada en Administración; 0 = apagado
REPORTES_AUTOMATICOS=1
